#!/command/with-contenv sh
# shellcheck shell=sh
# Morning brief (skills/morning-brief): install its cron scripts at every start.
#
# Hermes runs cron scripts only from $HERMES_HOME/scripts (a path resolving
# elsewhere is refused, symlinks included), so the image's run.sh and watch.sh
# are installed into /opt/data/scripts/morning-brief/ and overwritten here:
# the image stays the source of truth; change them through a PR.
#
# /opt/data/morning-brief/ (the owner's config.yaml, its .prev, records) is
# never touched here: only `morning-brief config set|unset` writes it, as hermes.
#
# Same rule as 50-homelab-credentials: root never writes in /opt/data (Hermes
# owns it and could plant symlinks); root only reads the image's files, every
# write in the volume runs as hermes through a fresh temp file + rename.
set -eu

SRC=/opt/hermes/skills/homelab/morning-brief
DST=/opt/data/scripts/morning-brief

as_hermes() { s6-setuidgid hermes "$@"; }
write_as_hermes() { # write_as_hermes <file> <mode>: stdin to <file>
    as_hermes sh -c 'umask 022; t=$(mktemp "$1.XXXXXX") && cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"' _ "$1" "$2"
}
unlink_symlinks() { for p in "$@"; do if [ -L "$p" ]; then as_hermes rm -f "$p"; echo "[homelab] removed symlink $p" >&2; fi; done; }

unlink_symlinks /opt/data/scripts "$DST" "$DST/run.sh" "$DST/watch.sh"
as_hermes mkdir -p "$DST"
for f in run.sh watch.sh; do
    write_as_hermes "$DST/$f" 0755 < "$SRC/$f"
done
echo "[homelab] morning brief scripts installed in $DST"
