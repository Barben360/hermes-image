#!/command/with-contenv sh
# shellcheck shell=sh
# GitHub credentials for gh and git, rebuilt from the mounted secrets at
# every start (runs as root after 01-hermes-setup has prepared /opt/data).
#
# Hermes strips GH_TOKEN/GITHUB_TOKEN from every tool subprocess, so gh reads
# its token from hosts.yml instead (GH_CONFIG_DIR, set in the Dockerfile):
#   - /run/secrets/github_token (root 0600) + /run/secrets/github_login:
#     hosts.yml is rewritten (hermes, 0600): a rotated token replaces the old;
#   - no token file: hosts.yml is removed, never left stale.
# git uses gh as its credential helper for github.com; user.name/user.email
# are set only when absent (Hermes may change its own git identity).
set -eu

TOKEN_FILE=/run/secrets/github_token
LOGIN_FILE=/run/secrets/github_login
GH_DIR=${GH_CONFIG_DIR:-/opt/data/home/.config/gh}
GITCONFIG=${GIT_CONFIG_GLOBAL:-/opt/data/home/.gitconfig}

as_hermes() { s6-setuidgid hermes "$@"; }

as_hermes mkdir -p "$GH_DIR"
hosts=$GH_DIR/hosts.yml

if [ ! -s "$TOKEN_FILE" ] || [ ! -s "$LOGIN_FILE" ]; then
    rm -f "$hosts"
    echo "[homelab] no GitHub token mounted: gh is logged out"
    exit 0
fi

login=$(tr -d '\r\n' < "$LOGIN_FILE")
token=$(tr -d '\r\n' < "$TOKEN_FILE")
case "$login" in
    ''|*[!A-Za-z0-9-]*) echo "[homelab] invalid GitHub login in $LOGIN_FILE" >&2; exit 1 ;;
esac

umask 077
tmp=$(mktemp "$GH_DIR/.hosts.XXXXXX")
# printf is a shell builtin: the token never appears in a process's argv.
printf 'github.com:\n    git_protocol: https\n    user: %s\n    oauth_token: %s\n    users:\n        %s:\n            oauth_token: %s\n' \
    "$login" "$token" "$login" "$token" > "$tmp"
unset token
chown hermes:hermes "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$hosts"

helper=credential.https://github.com.helper
if ! as_hermes git config --file "$GITCONFIG" --get-all "$helper" 2>/dev/null | grep -qx '!gh auth git-credential'; then
    as_hermes git config --file "$GITCONFIG" --replace-all "$helper" ''
    as_hermes git config --file "$GITCONFIG" --add "$helper" '!gh auth git-credential'
fi
as_hermes git config --file "$GITCONFIG" --get user.name >/dev/null 2>&1 ||
    as_hermes git config --file "$GITCONFIG" user.name "$login"
as_hermes git config --file "$GITCONFIG" --get user.email >/dev/null 2>&1 ||
    as_hermes git config --file "$GITCONFIG" user.email "$login@users.noreply.github.com"
echo "[homelab] gh logged in as $login"
