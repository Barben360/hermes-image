#!/command/with-contenv sh
# shellcheck shell=sh
# Git identity and GitHub credentials, rebuilt at every start (runs as root
# after 01-hermes-setup has prepared /opt/data).
#
# Identity: Hermes works with its owner's GitHub token, so its work is told
# apart by convention: every commit is authored "Hermes <hermes@bbarrois.tech>"
# and SSH-signed with a key that lives in the volume (generated once, kept
# across restarts; its public key is in my-homelab's allowed signers).
#
# Credentials: Hermes strips GH_TOKEN/GITHUB_TOKEN from every tool subprocess,
# so gh reads its token from hosts.yml instead (GH_CONFIG_DIR, Dockerfile):
#   - /run/secrets/github_token (root 0600) + /run/secrets/github_login:
#     hosts.yml is rewritten (hermes, 0600): a rotated token replaces the old;
#   - no token file: hosts.yml is removed, never left stale.
#
# Root never writes, chmods or removes anything under /opt/data: Hermes owns
# that volume and could plant a symlink there (root following it would hand
# Hermes any file of the image, e.g. a cont-init script or the managed scope).
# Root only reads /run/secrets; every file operation in the volume runs as
# hermes, so a symlink can only redirect a write Hermes could already make.
# Symlinks at the paths below are removed first (ci/smoke.sh plants them).
set -eu

TOKEN_FILE=/run/secrets/github_token
LOGIN_FILE=/run/secrets/github_login
GH_DIR=${GH_CONFIG_DIR:-/opt/data/home/.config/gh}
GITCONFIG=${GIT_CONFIG_GLOBAL:-/opt/data/home/.gitconfig}
SSH_DIR=/opt/data/home/.ssh
KEY=$SSH_DIR/hermes_signing
SIGNERS=/opt/data/home/.config/git/allowed_signers
NAME=Hermes
EMAIL=hermes@bbarrois.tech

as_hermes() { s6-setuidgid hermes "$@"; }
gc() { as_hermes git config --file "$GITCONFIG" "$@"; }
# write_as_hermes <file> <mode>: stdin to <file> through a fresh temp file
# (mktemp never follows a planted name), created and renamed by hermes.
write_as_hermes() {
    as_hermes sh -c 'umask 077; t=$(mktemp "$1.XXXXXX") && cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"' _ "$1" "$2"
}
unlink_symlinks() { for p in "$@"; do if [ -L "$p" ]; then as_hermes rm -f "$p"; echo "[homelab] removed symlink $p" >&2; fi; done; }

unlink_symlinks /opt/data/home /opt/data/home/.config /opt/data/home/.config/git "$SSH_DIR" "$GH_DIR" \
    "$KEY" "$KEY.pub" "$SIGNERS" "$SIGNERS.tmp" "$GITCONFIG" "$GH_DIR/hosts.yml"

# --- Identity and signing ---------------------------------------------------
as_hermes mkdir -p "$SSH_DIR" "$(dirname "$SIGNERS")"
as_hermes chmod 0700 "$SSH_DIR"
if [ ! -s "$KEY" ] || [ ! -s "$KEY.pub" ]; then
    as_hermes rm -f "$KEY" "$KEY.pub"
    as_hermes ssh-keygen -q -t ed25519 -N '' -C "$EMAIL" -f "$KEY"
    echo "[homelab] generated Hermes's commit signing key"
fi
as_hermes chmod 0600 "$KEY"
printf '%s namespaces="git" %s\n' "$EMAIL" "$(as_hermes cut -d' ' -f1,2 "$KEY.pub")" | write_as_hermes "$SIGNERS" 0644
gc user.name "$NAME"
gc user.email "$EMAIL"
gc gpg.format ssh
gc user.signingkey "$KEY.pub"
gc gpg.ssh.allowedSignersFile "$SIGNERS"
gc commit.gpgsign true
gc tag.gpgsign true
echo "[homelab] git signs as $NAME <$EMAIL>: $(as_hermes cut -d' ' -f1,2 "$KEY.pub")"

# --- GitHub credentials ------------------------------------------------------
as_hermes mkdir -p "$GH_DIR"
hosts=$GH_DIR/hosts.yml

if [ ! -s "$TOKEN_FILE" ] || [ ! -s "$LOGIN_FILE" ]; then
    as_hermes rm -f "$hosts"
    echo "[homelab] no GitHub token mounted: gh is logged out"
    exit 0
fi

login=$(tr -d '\r\n' < "$LOGIN_FILE")
token=$(tr -d '\r\n' < "$TOKEN_FILE")
case "$login" in
    ''|*[!A-Za-z0-9-]*) echo "[homelab] invalid GitHub login in $LOGIN_FILE" >&2; exit 1 ;;
esac

# printf is a shell builtin: the token goes through a pipe, never a
# process's argv.
printf 'github.com:\n    git_protocol: https\n    user: %s\n    oauth_token: %s\n    users:\n        %s:\n            oauth_token: %s\n' \
    "$login" "$token" "$login" "$token" | write_as_hermes "$hosts" 0600
unset token

helper=credential.https://github.com.helper
if ! gc --get-all "$helper" 2>/dev/null | grep -qx '!gh auth git-credential'; then
    gc --replace-all "$helper" ''
    gc --add "$helper" '!gh auth git-credential'
fi
echo "[homelab] gh uses the token of $login"
